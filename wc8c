% CDMA Simulation 
n = 1000; snr = 10;
u1 = randi([0 1],1,n); u2 = randi([0 1],1,n);
u1s = 2*u1 - 1; u2s = 2*u2 - 1;
chip = [1 -1 1 -1];
s1 = kron(u1s,chip); s2 = kron(u2s,chip);
tx = s1 + s2; rx = awgn(tx,snr,'measured');
r1 = filter(fliplr(chip),1,rx);
r2 = filter(fliplr(chip),1,rx);
d1 = r1(1:length(chip):end) > 0;
d2 = r2(1:length(chip):end) > 0;
ber1 = sum(d1~=u1)/n;
ber2 = sum(d2~=u2)/n;
figure;
subplot(3,1,1);
plot(tx); title('Transmitted CDMA Signal'); xlabel('Samples'); ylabel('Amplitude');
subplot(3,1,2);
plot(r1); title('Despread Signal - User 1'); xlabel('Samples'); ylabel('Amplitude');
subplot(3,1,3);
plot(r2); title('Despread Signal - User 2'); xlabel('Samples'); ylabel('Amplitude');
disp(['User1 BER: ',num2str(ber1)]);
disp(['User2 BER: ',num2str(ber2)]);

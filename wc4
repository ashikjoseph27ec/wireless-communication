%% EXPERIMENT 4 : BPSK OVER RICIAN FADING CHANNEL
clc; clear; close all;
%% PARAMETERS
N = 1e5;
EbN0_db = -5:2:20;
K_dB = 6;
K = 10^(K_dB/10);
%% TRANSMITTER
bits = randi([0 1],1,N);
bpsk_sig = 2*bits - 1;
%% CHANNEL PARAMETERS
mu = sqrt(K/(K+1));
sigma = 1/sqrt(2*(K+1));
BER_rician = zeros(1,length(EbN0_db));
%% SIMULATION LOOP
for i = 1:length(EbN0_db)
    noise = (randn(1,N) + 1i*randn(1,N)) / sqrt(2);
    h = sigma*(randn(1,N) + 1i*randn(1,N)) + mu;
    rx_sig = h .* bpsk_sig + noise * 10^(-EbN0_db(i)/20);
    rx_eq = rx_sig ./ h;
    rx_bits = real(rx_eq) > 0;
    BER_rician(i) = mean(rx_bits ~= bits);
end
%% THEORY
EbN0 = 10.^(EbN0_db/10);
BER_theory_rician = 0.5*erfc(sqrt((K.*EbN0)./(K + EbN0)));
%% PLOT
semilogy(EbN0_db, BER_rician, 'r', 'LineWidth',1.5); hold on;
semilogy(EbN0_db, BER_theory_rician, 'ro');
grid on;
xlabel('E_b/N_0 (dB)'); ylabel('Bit Error Rate (BER)');
legend('Simulated Rician','Theoretical Rician');
title('BPSK over Rician Fading Channel');
